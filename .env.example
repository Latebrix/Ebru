# Where ebru lives (src/links.ts). Copy this file to .env.local to change it for your own builds.
#
# Move every address at once:
# VITE_EBRU_DOMAIN=ebru.ink
#
# Or point one address somewhere else, a local copy for example:
# VITE_SITE_URL=http://localhost:5173/
# VITE_APP_URL=http://localhost:5174/
# VITE_SHOW_URL=http://localhost:5175/
# VITE_KALEM_URL=http://localhost:5176/
# VITE_API_URL=https://api.ebru.ink/v1
